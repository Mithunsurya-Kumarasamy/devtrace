# DevTrace Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# Application Settings
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DEVTRACE_VERSION=1.0.0

# PostgreSQL Configuration
POSTGRES_DB=devtrace
POSTGRES_USER=devtrace
POSTGRES_PASSWORD=devtrace
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/devtrace

# Apache Kafka Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# GitHub Integration
# Personal Access Token or GitHub App token (Optional for public rate-limited endpoints, required for private or high volume)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_API_URL=https://api.github.com

# Analytics Python Service
PYTHON_SERVICE_URL=http://localhost:5000

# Frontend Configuration
VITE_API_BASE_URL=/api
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
